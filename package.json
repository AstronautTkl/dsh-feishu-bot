{
  "name": "dsh-feishu-bot",
  "version": "0.7.2",
  "description": "Bridge DSH session status, approvals and conversation content to a Feishu (Lark) bot over a long connection — approve tool calls from your phone.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "bot",
    "approval",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "author": "Timeout",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstronautTkl/dsh-feishu-bot.git"
  },
  "homepage": "https://github.com/AstronautTkl/dsh-feishu-bot#readme",
  "bugs": {
    "url": "https://github.com/AstronautTkl/dsh-feishu-bot/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
